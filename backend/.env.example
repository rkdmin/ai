# Gemini API key (필수)
GEMINI_API_KEY=

# CORS — 콤마 구분 (운영 도메인 추가 시 늘리기)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost

# 서버 포트 (Render/Railway 는 PORT 환경변수 자동 주입)
PORT=8000

# 로컬 개발용 — true 면 rate limit 우회 (운영에는 절대 설정 금지)
RATE_LIMIT_DISABLED=false

# Phase 3 — Supabase Auth/REST/Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=analysis-photos

# 사진 보관 기간(일). 안내 문구는 GET /api/account/policy 로 이 값을 읽어 표시한다
PHOTO_RETENTION_DAYS=90
GENERATED_PHOTO_RETENTION_DAYS=30

# 리포트 접근 — entitlement(기본, P4 전엔 항상 거부) | open(로컬 개발·테스트용. 운영 금지)
REPORT_ACCESS_MODE=entitlement

# 구 무료 카드 API(/api/cards/*, 카드 기반 TRY ON) — open(기본) | report_only(프론트가 리포트로 옮긴 뒤 닫는다)
CARDS_API_MODE=open

# STYLE 콘텐츠·제품 사전의 초안(draft)을 API 에 섞을지 — 로컬 개발 전용. 운영은 비워 둔다 (published 만)
STYLE_INCLUDE_DRAFTS=

# 운영 엔드포인트(/api/admin/*) 토큰. 비우면 404 로 숨겨진다. 만료 사진 정리는 cron 으로 jobs.cleanup_expired_photos 를 돌려도 된다
ADMIN_TOKEN=
